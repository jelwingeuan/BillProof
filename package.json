{
  "name": "billproof-local-verifier",
  "version": "0.2.0",
  "description": "A local verifier for subscription entitlement behavior.",
  "license": "MIT",
  "repository": "github:jelwingeuan/BillProof",
  "bugs": "https://github.com/jelwingeuan/BillProof/issues",
  "homepage": "https://github.com/jelwingeuan/BillProof#readme",
  "private": true,
  "engines": { "node": "^24.0.0" },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "target": "tsx scripts/sample-target.ts",
    "doctor": "tsx scripts/doctor.ts",
    "cli": "tsx scripts/billproof.ts",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "smoke:production": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
